# Base de dados PostgreSQL (Supabase)
# DATABASE_URL: connection pooling (Transaction, porta 6543, com ?pgbouncer=true) — usado pela app
# DIRECT_URL: ligação direta (porta 5432) — usado pelas migrações Prisma
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Segredo do Auth.js — gerar com: npx auth secret
AUTH_SECRET=""

# (Opcional) Passwords iniciais do seed. Se não definidas, usa "futsal2026".
SEED_PASS_GONCALO=""
SEED_PASS_ADJUNTO=""
